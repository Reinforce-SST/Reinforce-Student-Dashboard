# ---- Secrets. Never commit these. ----
.env
.env.*
!.env.example
# Firebase admin keys. The middle pattern is the filename Firebase actually
# gives you on download (reinforce-sst-...-firebase-adminsdk-fbsvc-....json),
# which the two conventional names below would not have caught.
**/*serviceAccount*.json
**/*firebase-adminsdk*.json
**/serviceAccountKey.json
**/firebase_credentials.json
*.pem
*.key

# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# ---- Node ----
node_modules/
dist/
dist-ssr/
.next/
out/
*.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---- Tooling / deploy ----
.vercel/
.turbo/
coverage/

# ---- Editors ----
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*.swo

# ---- OS ----
.DS_Store
Thumbs.db
