# Firebase web config. Publishable — the browser needs these. Ask a core member.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Reinforce API.
# Local:      http://localhost:8080/api/v1
# Deployed:   https://reinforce-student-dashboard.onrender.com/api/v1
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080/api/v1

# Canonical site origin, used for metadata and social cards.
# Leave unset locally; Vercel fills VERCEL_URL for previews.
NEXT_PUBLIC_SITE_URL=
